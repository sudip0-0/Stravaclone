# Reference-only inventory. Do not copy values into source control or use this as an env file.
# Secret values must be created in Koyeb under the names on the right.
DATABASE_URL=<secret:TRAIL_BETA_DATABASE_URL> # Neon pooled TLS URL; append sslmode=require
OBJECT_STORAGE_ENDPOINT=<secret:TRAIL_BETA_R2_ENDPOINT> # account-id.r2.cloudflarestorage.com, hostname only
OBJECT_STORAGE_ACCESS_KEY=<secret:TRAIL_BETA_R2_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<secret:TRAIL_BETA_R2_SECRET_KEY>
OBJECT_STORAGE_BUCKET=<secret:TRAIL_BETA_R2_BUCKET>
MAP_STYLE_URL=<secret:TRAIL_BETA_MAP_STYLE_URL> # approved HTTPS style document; OpenFreeMap is not hard-coded in deployment
SMTP_USER=<secret:TRAIL_BETA_SMTP_USER>
SMTP_PASSWORD=<secret:TRAIL_BETA_SMTP_PASSWORD>
SMTP_FROM=<secret:TRAIL_BETA_SMTP_FROM>
JWT_SIGNING_KEY=<secret:TRAIL_BETA_JWT_SIGNING_KEY> # independent 32-byte base64url value
EMAIL_OUTBOX_KEY=<secret:TRAIL_BETA_EMAIL_OUTBOX_KEY> # independent 32-byte base64url value
REFRESH_RECOVERY_KEY=<secret:TRAIL_BETA_REFRESH_RECOVERY_KEY> # independent 32-byte base64url value
# Backup-runner-only mounted files; never expose these to the API service or backup destination:
BACKUP_ENCRYPTION_KEY_FILE=<secret-file:TRAIL_BETA_BACKUP_ENCRYPTION_KEY> # chmod 600 passphrase file
BACKUP_ENCRYPTION_KEY_VERSION=<version:TRAIL_BETA_BACKUP_ENCRYPTION_KEY>
BACKUP_AUTHENTICATION_KEY_FILE=<secret-file:TRAIL_BETA_BACKUP_AUTHENTICATION_KEY> # distinct chmod 600 HMAC key file
BACKUP_AUTHENTICATION_KEY_VERSION=<version:TRAIL_BETA_BACKUP_AUTHENTICATION_KEY>
# Optional only after a scrubbed collector is selected:
OTEL_EXPORTER_OTLP_ENDPOINT=<secret:TRAIL_BETA_OTLP_ENDPOINT>
