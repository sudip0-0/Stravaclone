{
  "name": "trail",
  "version": "0.0.0",
  "private": true,
  "description": "Trail mobile and API workspace",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "audit:security": "pnpm audit --audit-level moderate --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "dev:api": "pnpm --filter @trail/api dev",
    "dev:mobile": "pnpm --filter @trail/mobile start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "infra:reset": "docker compose -f infra/compose.yaml down --volumes",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait postgres minio mailpit && docker compose -f infra/compose.yaml run --rm minio-init",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:api": "pnpm --filter @trail/api test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.8",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "2.8.0",
      "@opentelemetry/exporter-prometheus": "0.221.0",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "esbuild@<=0.24.2": "0.25.12",
      "fast-xml-parser": "5.7.0",
      "protobufjs": "8.7.2",
      "uuid@<11.1.1": "11.1.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
