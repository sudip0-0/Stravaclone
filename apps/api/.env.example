# Copy to apps/api/.env. Values below are local-development only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://trail:trail_local_only@127.0.0.1:5433/trail
OBJECT_STORAGE_ENDPOINT=127.0.0.1
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=trail-app
OBJECT_STORAGE_SECRET_KEY=trail-app-local-value
OBJECT_STORAGE_BUCKET=trail-private
EMAIL_MODE=smtp
EMAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@trail.local
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Generate each distinct key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SIGNING_KEY=
EMAIL_OUTBOX_KEY=
REFRESH_RECOVERY_KEY=
JWT_ISSUER=trail-api
JWT_AUDIENCE=trail-mobile
# SSO HTTP routes remain disabled regardless of client-ID configuration.
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Local direct traffic is 0; Koyeb production uses the validated hop count 1.
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=32768
READINESS_TIMEOUT_MS=1000
READINESS_CACHE_MS=1000
OTEL_ENABLED=false
# Required only when OTEL_ENABLED=true. Production requires nonlocal HTTPS.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
