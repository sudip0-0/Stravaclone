# Public values embedded in the app bundle; never place secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Build-time map style and provider disclosure; changing any value requires a rebuilt/tested/released Expo bundle.
# OpenStreetMap attribution remains visible on every map regardless of the configured provider.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_PROVIDER_NAME=OpenFreeMap
EXPO_PUBLIC_MAP_PROVIDER_URL=https://openfreemap.org
# Optional public OAuth client identifiers. Buttons remain unavailable without native provider setup.
# EXPO_PUBLIC_APPLE_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
