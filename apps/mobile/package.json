{
  "name": "@trail/mobile",
  "version": "0.0.0",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo"
      ]
    }
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ios": "expo start --ios",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "11.3.4",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.18.16",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "@trail/contracts": "workspace:*",
    "@trail/domain": "workspace:*",
    "expo": "57.0.13",
    "expo-build-properties": "57.0.13",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-picker": "57.0.12",
    "expo-location": "57.0.12",
    "expo-notifications": "57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-task-manager": "57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "3.2.7"
  }
}
