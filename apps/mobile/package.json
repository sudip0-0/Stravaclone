{
  "name": "@trail/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ios": "expo start --ios",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "expo": "56.0.14",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14"
  }
}
